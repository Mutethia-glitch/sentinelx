{
  "name": "sentinelx",
  "version": "0.1.0",
  "private": true,
  "description": "IPHYN's Intelligent Cybersecurity Incident Detection and Response System",
  "scripts": {
    "check:foundation": "node scripts/check-foundation.js",
    "lint": "node scripts/lint.js",
    "test": "npm run check:foundation && node --test tests/auth/*.test.js tests/access/*.test.js tests/events/*.test.js tests/threats/*.test.js tests/rules/*.test.js tests/alerts/*.test.js tests/correlation/*.test.js tests/incidents/*.test.js",
    "quality": "npm run lint && npm test",
    "db:migrate": "node scripts/migrate.js",
    "test:database": "node scripts/test-database.js",
    "test:auth:integration": "node --test tests/integration/auth.test.js",
    "start": "node src/api/server.js",
    "auth:create-user": "node scripts/create-user.js",
    "test:rbac:integration": "node --test tests/integration/access.test.js",
    "rbac:bootstrap": "node scripts/bootstrap-administrator.js",
    "test:rbac:ui": "node --test tests/integration/access-ui.test.js",
    "test:events:integration": "node --test tests/integration/events.test.js",
    "test:ingestion:integration": "node --test tests/integration/ingestion.test.js",
    "test:events:ui": "node --test tests/integration/events-ui.test.js",
    "test:categories:integration": "node --test tests/integration/categories.test.js",
    "test:rules:integration": "node --test tests/integration/rules.test.js",
    "test:detection:integration": "node --test tests/integration/detection.test.js",
    "verify:detection": "node scripts/verify-detection.js",
    "test:initial-rules:integration": "node --test tests/integration/initial-rules.test.js",
    "verify:initial-rules": "node scripts/verify-initial-rules.js",
    "test:alert-model:integration": "node --test tests/integration/alert-model.test.js",
    "verify:alert-model": "node scripts/verify-alert-model.js",
    "test:alerts:integration": "node --test tests/integration/alert-management.test.js",
    "test:alerts:ui": "node --test tests/integration/alerts-ui.test.js",
    "verify:alerts": "node scripts/verify-alert-management.js",
    "test:alert-management:integration": "node --test tests/integration/alert-management.test.js",
    "test:correlation:integration": "node --test tests/integration/correlation.test.js",
    "verify:correlation": "node scripts/verify-correlation.js",
    "test:incidents:integration": "node --test tests/integration/incidents.test.js",
    "test:incidents:ui": "node --test tests/integration/incidents-ui.test.js",
    "verify:incidents": "node scripts/verify-incident-management.js",
    "test:incident-classification:integration": "node --test tests/integration/incident-classification.test.js",
    "test:incident-classification:ui": "node --test tests/integration/incident-classification-ui.test.js",
    "verify:incident-classification": "node scripts/verify-incident-classification.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
