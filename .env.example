# SentinelX local environment template
# Copy this file to .env for local development.
# Never commit real credentials or secrets.

NODE_ENV=development

# PostgreSQL is the approved database direction. Task 04 will finalize
# the concrete database setup and connection requirements.
DATABASE_URL=postgresql://sentinelx_user:change_me@localhost:5432/sentinelx

# Replace locally when authentication is implemented in later tasks.
# Do not place production secrets in this example file.
JWT_SECRET=replace_with_a_local_development_secret

# Task 05: origin and optional one-time local user provisioning (no real secrets)
APP_ORIGIN=http://localhost:3000
AUTH_USER_EMAIL=
AUTH_USER_NAME=
AUTH_USER_PASSWORD=

# Task 06: optional first-Administrator setup for an existing local account
RBAC_BOOTSTRAP_EMAIL=
