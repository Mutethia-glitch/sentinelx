# SentinelX local environment template
# Copy this file to .env for local development.
# Never commit real credentials or secrets.

NODE_ENV=development

# PostgreSQL is the approved database direction. Task 04 will finalize
# the concrete database setup and connection requirements.
DATABASE_URL=postgresql://sentinelx_user:change_me@localhost:5432/sentinelx

# Replace locally when authentication is implemented in later tasks.
# Do not place production secrets in this example file.

# Task 05: origin and optional one-time local user provisioning (no real secrets)
APP_ORIGIN=http://localhost:3000
AUTH_USER_EMAIL=
AUTH_USER_NAME=
AUTH_USER_PASSWORD=

# Task 06: optional first-Administrator setup for an existing local account
RBAC_BOOTSTRAP_EMAIL=

# Approved ingestion source labels; comma-separated, requires server restart.
EVENT_INGEST_SOURCES=sentinelx-simulated

# Task 41: production isolated-tenant deployment.
# Real values belong in the deployment secret manager, never in this file.
BIND_HOST=127.0.0.1
TENANT_ID=
TENANT_NAME=
TENANT_SLUG=
AUTH_EMAIL_2FA=0
AUTH_OTP_SECRET=
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=
EMAIL_FROM=
TRUSTED_PROXY_IPS=

# Separate public company-onboarding control plane.
PLATFORM_PORT=3100
PLATFORM_BIND_HOST=127.0.0.1
PLATFORM_ORIGIN=
PLATFORM_DATABASE_URL=
PLATFORM_OTP_SECRET=
TENANT_BASE_DOMAIN=
TENANT_PROVISIONER_URL=
TENANT_PROVISIONER_TOKEN=
