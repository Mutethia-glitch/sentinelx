# SentinelX tenant runtime template. Supply real values through a secret manager.
NODE_ENV=production
PORT=3000
BIND_HOST=0.0.0.0
APP_ORIGIN=https://company.example.com
DATABASE_URL=
TENANT_ID=
TENANT_NAME=
TENANT_SLUG=
AUTH_EMAIL_2FA=1
AUTH_OTP_SECRET=
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=
EMAIL_FROM=
TRUSTED_PROXY_IPS=
EVENT_INGEST_SOURCES=

# Optional Vercel signed firewall log-drain receiver. All four blank => disabled.
# Configure only after confirming Vercel Pro/Enterprise Drains availability and
# reviewing actual project, host and narrowly classified WAF rule IDs.
# Drain signature secret belongs ONLY in this tenant's Render secret environment.
VERCEL_FIREWALL_DRAIN_SECRET=
VERCEL_FIREWALL_PROJECT_ID=
VERCEL_FIREWALL_HOST=
VERCEL_FIREWALL_RULE_MAP=

# Optional additional authoritative source credentials, one issuer/source per token.
# All are disabled when empty; never share with frontend or another tenant.
SECURITY_EVIDENCE_FEEDS_JSON=[]
